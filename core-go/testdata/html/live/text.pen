{
  "version": "2.19",
  "children": [
    {"type": "frame", "id": "texts", "x": 0, "y": 0, "width": 600, "height": 400, "layout": "vertical", "gap": 8, "padding": 10, "fill": "#fff", "children": [
      {"type": "text", "id": "t1", "content": "Hello, World & <friends>", "fontFamily": "Arial", "fontSize": 18, "fill": "#111"},
      {"type": "text", "id": "t2", "content": "Bold and spaced", "fontFamily": "Arial", "fontSize": 16, "fontWeight": "bold", "letterSpacing": 1.5, "fill": "#333", "underline": true, "strikethrough": true},
      {"type": "text", "id": "t3", "width": 200, "textGrowth": "fixed-width", "content": "Centred text that wraps\nacross a few lines", "fontFamily": "Arial", "fontSize": 14, "lineHeight": 1.6, "textAlign": "center", "fill": "#06c"},
      {"type": "text", "id": "t4", "width": 180, "height": 60, "textGrowth": "fixed-width-height", "content": "Bottom text", "fontFamily": "Arial", "fontSize": 12, "textAlignVertical": "bottom", "fill": {"type": "gradient", "colors": [{"color": "#f00", "position": 0}, {"color": "#00f", "position": 1}]}},
      {"type": "text", "id": "t5", "textGrowth": "fixed-width-height", "content": "Middle", "fontFamily": "Arial", "fontSize": 16, "textAlignVertical": "middle", "fill": "#000"},
      {"type": "text", "id": "t6", "content": "Italic light", "fontFamily": "Arial", "fontSize": 20, "fontStyle": "italic", "fontWeight": 300, "fill": {"type": "image", "url": "pic.png", "mode": "fill", "opacity": 0.5}, "opacity": 0.8},
      {"type": "text", "id": "t7", "content": "Outlined", "fontFamily": "Arial", "fontSize": 28, "fill": "#ff0", "stroke": "#000", "strokeWidth": 2, "strokeAlignment": "outer", "effect": [{"type": "shadow", "offset": {"x": 2, "y": 2}, "blur": 3}, {"type": "shadow", "offset": {"x": -1, "y": 4}, "color": "#f008"}]},
      {"type": "text", "id": "t8", "content": "Hollow", "fontFamily": "Segoe UI", "fontSize": 28, "stroke": "#0a0", "strokeWidth": {"top": 3}},
      {"type": "text", "id": "t9", "content": "Grad shadows", "fontFamily": "Arial", "fontSize": 24, "fill": {"type": "gradient", "gradientType": "radial", "colors": [{"color": "#f00", "position": 0}, {"color": "#00f", "position": 1}]}, "underline": true, "effect": [{"type": "shadow", "offset": {"x": 6, "y": 6}, "blur": 4, "color": "#ff0000"}, {"type": "shadow", "offset": {"x": 1, "y": 9}, "blur": 2}]},
      {"type": "text", "id": "t10", "width": 0, "textGrowth": "fixed-width", "content": "one two", "fontFamily": "Arial", "fontSize": 12, "rotation": 10}
    ]},
    {"type": "text", "id": "solo", "x": 700, "y": 0, "content": "Solo & alone\n\nwith  gaps", "fontFamily": "Segoe UI", "fontSize": 15, "fill": "#123456", "opacity": 0.8}
  ]
}
