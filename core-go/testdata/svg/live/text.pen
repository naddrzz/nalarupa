      {"type": "text", "id": "t3", "x": 10, "y": 70, "width": 200, "textGrowth": "fixed-width", "content": "Centred text that wraps across a few lines in a fixed width box", "fontFamily": "Arial", "fontSize": 14, "lineHeight": 1.6, "textAlign": "center", "fill": "#06c"},
      {"type": "text", "id": "t4", "x": 230, "y": 70, "width": 160, "textGrowth": "fixed-width", "content": "Right aligned words\nwith a hard break", "fontFamily": "Arial", "fontSize": 13, "textAlign": "right", "fill": ["#c00", {"type": "color", "color": "#00f8", "blendMode": "multiply"}], "strikethrough": true},
